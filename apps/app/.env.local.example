# Copy this file to .env.local and fill in your own values.
# Both come from your Supabase project: Settings → API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# eBay Partner Network campaign ID (10 digits), from the EPN dashboard:
# Campaigns → your campaign. Leave unset and every eBay link stays untagged —
# lib/epn.js is a no-op without it, so this is safe to deploy before approval.
NEXT_PUBLIC_EPN_CAMPID=

# Multi-copy listings, kept in step with nobody watching (lib/copysync.js).
# Unset or "off": nothing. "dry": works it all out and logs it, sends nothing.
# "on": revises pooled listings' pictures and quantities on eBay.
COPY_SYNC=
# The eBay developer account's Dev ID (same keyset page as the client id and
# secret). Needed only to verify eBay's sale notifications at /api/ebay/notify.
EBAY_DEV_ID=

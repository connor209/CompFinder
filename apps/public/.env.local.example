# Public price page (apps/public). Copy to .env.local and fill in.

# Same Supabase project as the business app — the catalogue and the cache are
# shared, which is the point: your batch runs warm the cache this page serves.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Writes the cache and the rate-limit counters, both of which
# have RLS on with no policies so the anon key can't reach them. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single shared SoldComps key every visitor's search is billed to.
# This is the one that needs SoldComps' written OK before the page goes public
# — see docs/PUBLIC_SEARCH_ADS.md, "The API key question".
SOLDCOMPS_API_KEY=

# eBay Partner Network campaign ID. LEAVE BLANK until the page has real
# visitors: while you're the only user, every click is your own.
NEXT_PUBLIC_EPN_CAMPID=

# Where the paid app lives, for the "Sign in" and "See Pro" links.
NEXT_PUBLIC_APP_URL=https://comp-finder-alpha.vercel.app
# Canonical URL for metadata / og tags.
NEXT_PUBLIC_SITE_URL=https://compfinder.co.uk

# Per-IP hourly cap on /api/price. Defaults to 120; only raise it if real
# visitors are hitting it. To let an audit run past the cap, use AUDIT_TOKEN
# below rather than raising this for everyone.
PUBLIC_RATE_LIMIT_PER_HOUR=

# Shared secret that exempts a caller from the rate limit, for our own audit
# runs. Exempts from the LIMIT only — the cache and every other guard still
# apply. Leave blank and no bypass exists. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AUDIT_TOKEN=

# --- Bot protection (Cloudflare Turnstile) --------------------------------
# Both blank = off, and /api/price behaves exactly as it did. Set BOTH or
# neither: the secret alone would ask every visitor for a check the page has
# no site key to solve.
#
# The site key is public (it goes in the page); the secret is server-only and
# also signs the pass cookie, so changing it invalidates every pass in flight
# — which is the right behaviour, just worth knowing.
#
# Once this is on, AUDIT_TOKEN above stops being a convenience and becomes
# required for our own runs: a script has no browser, so without the token
# every audit request is answered with a challenge it cannot solve.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Pacing our own calls to SoldComps -------------------------------------
# Their limit is 60 requests/minute across the WHOLE key, and every visitor's
# search is billed to the one key above. Defaults are 1100ms between calls
# (~54/min) and 4000ms as the longest a visitor waits for a slot before the
# request is shed with a "try again in a few seconds". Only set these if you
# have measured a reason to.
SOLDCOMPS_MIN_GAP_MS=
SOLDCOMPS_MAX_WAIT_MS=
